#!/bin/sh
# pre-commit: lint staged files only
# Copy to .git/hooks/pre-commit and chmod +x

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

FAIL=0

# --- Frontend: ESLint on staged .ts/.tsx/.js/.jsx files under frontend/ ---
FRONTEND_FILES=$(echo "$STAGED_FILES" | grep '^frontend/.*\.\(ts\|tsx\|js\|jsx\)$')

if [ -n "$FRONTEND_FILES" ]; then
  echo "Running ESLint on staged frontend files..."
  (cd frontend && echo "$FRONTEND_FILES" | sed 's|^frontend/||' | xargs npx eslint)
  if [ $? -ne 0 ]; then
    echo "ESLint failed. Fix the issues above or commit with --no-verify to skip."
    FAIL=1
  fi
fi

