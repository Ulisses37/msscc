# === Django ===
DJANGO_SECRET_KEY=
# Comma-separated Fernet keyring. Put the active key first, then prior keys.
FIELD_ENCRYPTION_KEYS=
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development

# Server Configuration (only needed for remote dev environments)
# Uncomment and set to your server's IP if using JetBrains Gateway or similar
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<your-server-tailscale-ip>

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
# For remote dev, add your server IP:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://<your-server-tailscale-ip>:3000

# === API Throttling ===
# Public volunteer signups allowed per IP. Defaults to 5/hour when unset.
VOLUNTEER_SIGNUP_THROTTLE_RATE=
# Set to the number of trusted reverse proxies in production. Leave blank locally.
THROTTLE_NUM_PROXIES=

# === PostgreSQL ===
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# === MinIO / S3 Storage ===
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto

# === Resend (email) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000
RESEND_DEV_ALERT_EMAIL=

# Email provider adapter selected by emails.providers.get_provider().
EMAIL_PROVIDER=resend

# Resend segment that mailing-list contacts belong to and announcements are
# sent to. Find it in the Resend dashboard under Contacts > Segments.
RESEND_SEGMENT_ID=

# Svix signing secret for the Resend webhook that reports unsubscribes.
# Find it on the webhook's detail page in the Resend dashboard.
RESEND_WEBHOOK_SECRET=

# Shared secret used to authenticate the external scheduler (Railway cron job)
# when it POSTs to /api/trigger/event-reminders/ or
# /api/trigger/membership-reminders/. Send the value in the "X-API-Key" header.
TRIGGER_API_KEY=

# Email the mailing list when a new event is created. Ships dark: leave this
# unset or false until a verified Resend sending domain exists and the enable
# procedure in docs/ has been completed.
EVENT_ANNOUNCEMENTS_ENABLED=true

# Send membership expiry reminders. Ships dark for the same reason: leave this
# unset or false until a verified Resend sending domain exists. A dry run
# (`manage.py send_membership_expiry_reminders --dry-run`) works while this is
# off, so the recipient list can be reviewed first.
MEMBERSHIP_REMINDERS_ENABLED=


# === Stripe (payment)===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
